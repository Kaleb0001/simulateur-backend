# Authentification de l'API (Authorization: Bearer <token>)
SIMULATEUR_API_TOKEN=change-moi-en-production

# Valeurs par defaut du compte auto-cree a la creation d'un client
# (type : courant, epargne ou bloque)
TYPE_COMPTE_PAR_DEFAUT=courant
DEVISE_PAR_DEFAUT=XOF
SOLDE_INITIAL_PAR_DEFAUT=0
PREFIXE_NUMERO_COMPTE=CPT

# Base de donnees
DATABASE_URL=sqlite:///./simulateur_imf.db

# Adresse de l'API renvoyée à un système tiers connecté (avec son jeton)
URL_PUBLIQUE_API=http://127.0.0.1:8011/api/v1
