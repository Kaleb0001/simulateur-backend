# Authentification de l'API (Authorization: Bearer <token>)
SIMULATEUR_API_TOKEN=change-moi-en-production

# Valeurs par defaut du compte auto-cree a la creation d'un client
# (type : courant, epargne ou bloque)
TYPE_COMPTE_PAR_DEFAUT=courant
DEVISE_PAR_DEFAUT=XOF
SOLDE_INITIAL_PAR_DEFAUT=0
PREFIXE_NUMERO_COMPTE=CPT

# Base de données PostgreSQL : serveur Docker de IMF_SHIELD/infra/postgres
# (port 5434, base simulateur_imf, utilisateur simulateur ; mot de passe
# SIMULATEUR_DB_PASSWORD du .env de infra/postgres, encodé pour l'URL).
# Une URL sqlite:///../simulateur_imf.db reste acceptée pour un essai sans serveur.
DATABASE_URL=postgresql+psycopg://simulateur:mot-de-passe@localhost:5434/simulateur_imf
# Réglages facultatifs du pool et de la charge
# DATABASE_POOL_SIZE=20
# DATABASE_MAX_OVERFLOW=30
# DATABASE_POOL_TIMEOUT_SECONDES=10
# REQUETES_SIMULTANEES_MAX=15

# Adresse de l'API renvoyée à un système tiers connecté (avec son jeton)
URL_PUBLIQUE_API=http://127.0.0.1:8011/api/v1
